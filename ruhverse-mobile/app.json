{
  "expo": {
    "name": "RuhVerse",
    "slug": "ruhverse",
    "scheme": "ruhverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A100D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ruhverse.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RuhVerse needs your location to calculate accurate Islamic prayer times and Qibla direction."
      }
    },
    "android": {
      "package": "com.ruhverse.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A100D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "929ce63d-83c5-463b-9109-fdca25c2047f"
      }
    },
    "owner": "essenziatdigital"
  }
}
