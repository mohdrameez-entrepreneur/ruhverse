{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "Blog Pages/**",
          "quran.html",
          "qibla.html",
          "terms.html",
          "prayer-times-global.html",
          "prayer-times-india.html",
          "prayer-times-new-delhi.html",
          "prayer-times-city.html",
          "style.css",
          "footer_styles.css",
          "theme.js",
          "script.js",
          "script_3d.js",
          "qibla.js",
          "robots.txt",
          "google50b824ea32f5425b.html",
          "assets/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
